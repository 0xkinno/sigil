# ============================================================================
# SIGIL — Environment Variables Template
# Copy this file to .env.local and fill in real values there.
# NEVER put real keys in this file — it is committed to git and is public.
# ============================================================================

# ---- Provider A (Alchemy) ---------------------------------------------------
# Sign up at https://www.alchemy.com/ — use MAINNET endpoints (not testnet)
ALCHEMY_ETH_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
ALCHEMY_BASE_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
ALCHEMY_ARB_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
ALCHEMY_OPT_URL=https://opt-mainnet.g.alchemy.com/v2/YOUR_KEY
ALCHEMY_POLY_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY

# ---- Provider B (public RPCs — no key needed) -------------------------------
BACKUP_ETH_URL=https://ethereum-rpc.publicnode.com
BACKUP_BASE_URL=https://mainnet.base.org
BACKUP_ARB_URL=https://arb1.arbitrum.io/rpc
BACKUP_OPT_URL=https://mainnet.optimism.io
BACKUP_POLY_URL=https://polygon-bor-rpc.publicnode.com

# ---- Server ------------------------------------------------------------------
PORT=3000
NODE_ENV=production

# ---- Registration (Base Sepolia testnet) -------------------------------------
# A SEPARATE wallet just for testnet registration — never use a mainnet wallet
MINER_PRIVATE_KEY=0x_YOUR_BASE_SEPOLIA_PRIVATE_KEY_HERE
BASE_SEPOLIA_RPC=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY

# ---- Rate Limiting -----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
